# Python
__pycache__/
*.py[cod]

# 本机密钥与代理缓存（绝不上传）
collector/.google_key
collector/.wb_key
collector/.proxy.cache

# 本机一键推送脚本（只给自己用，不需要进仓库）
push-to-github.bat

# 每次运行产生的临时产出（榜单基线除外）
collector/out/batch_*.json
collector/out/report_*.md
collector/out/charts/snapshot_*.json
collector/out/charts/report_*.md
collector/out/charts/events_*.json

# 微信云开发 AppSecret（最高权限，绝不上传）
.tcb_secret
.tcb_token.json
collector/.tcb_secret
collector/.tcb_token.json

# 本机翻译缓存（不入库）
collector/out/.zh_cache.json
